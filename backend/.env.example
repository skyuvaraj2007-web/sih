PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here

# PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=skillnexus_db
# Alternatively use connection string:
# DATABASE_URL=postgresql://user:password@localhost:5432/skillnexus_db

# Google Identity Services / OAuth 2.0 Credentials
# Get your OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
