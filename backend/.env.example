# ==============================================================================
# SKILL NEXUS AI — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_minimum_32_chars_here

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection Pool (pg driver)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ------------------------------------------------------------------------------
# CORS & Client Configuration
# Local: CLIENT_URL=http://localhost:5173
# Vercel: CLIENT_URL=https://your-project.vercel.app
# ------------------------------------------------------------------------------
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
